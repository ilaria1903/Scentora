<!DOCTYPE html>
<html lang="ro">
<head>
  
    <%- include("../fragmente/head.ejs")%>


   
</head>




<body>
 
    <%- include("../fragmente/header.ejs")%>

    <main>
    <h2>Branduri</h2>
    <section class="grid-produse">
        <% for (let brand of produse) { %>
            <article class="produs">
                <h3><%- brand.nume_brand %></h3>
                <p>Tip: <%- brand.tip_brand %></p>
                <p>Țara de origine: <%- brand.tara_origine %></p>
                <p>Înființat în: <%- brand.data_infiintare.toLocaleDateString() %></p>
            </article>
        <% } %>
    </section>
</main>
    <%- include("../fragmente/footer.ejs")%>
    </body>
</html>
   